<Window x:Class="CPUMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Icon="Assets/app.ico"
        Width="440"
        Height="460"
        MinWidth="380"
        MinHeight="360"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8F9FA">

    <Grid>

        <Grid.RowDefinitions>
            <!-- 0: Encabezado fijo -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Contenido con Scroll -->
            <RowDefinition Height="*"/>
            <!-- 2: Pie con botones fijo -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================== -->
        <!-- ENCABEZADO -->
        <!-- ===================================== -->

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="22,16,22,14">

            <TextBlock Text="Configuración"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#111827"/>

        </Border>


        <!-- ===================================== -->
        <!-- CUERPO DESPLAZABLE (SCROLLVIEWER) -->
        <!-- ===================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">

            <StackPanel Margin="22,16,22,20">

                <!-- TRANSPARENCIA -->
                <TextBlock Text="Transparencia"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="OpacitySlider"
                            Grid.Column="0"
                            Minimum="25"
                            Maximum="100"
                            VerticalAlignment="Center"
                            ValueChanged="OpacitySlider_ValueChanged"/>

                    <TextBlock x:Name="OpacityText"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#374151"/>
                </Grid>


                <!-- OPCIONES GENERALES -->
                <CheckBox x:Name="AlwaysOnTopCheck"
                          Content="Mantener siempre encima"
                          FontSize="13"
                          Foreground="#1F2937"
                          Margin="0,0,0,10"/>

                <CheckBox x:Name="StartupCheck"
                          Content="Iniciar automáticamente con Windows"
                          FontSize="13"
                          Foreground="#1F2937"
                          Margin="0,0,0,16"/>


                <!-- TEMA -->
                <GroupBox Header="Tema"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="#1F2937"
                          Padding="12,10,12,12"
                          Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock Text="Personaliza la apariencia del fondo:"
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="ThemeComboBox"
                                  Height="32"
                                  FontSize="13"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Oscuro (Por defecto)" Tag="Default"/>
                            <ComboBoxItem Content="SpeedRunners" Tag="SpeedRunners"/>
                        </ComboBox>

                    </StackPanel>

                </GroupBox>


                <!-- INDICADORES -->
                <GroupBox Header="Indicadores"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="#1F2937"
                          Padding="12,10,12,12"
                          Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock Text="CPU y RAM siempre estarán visibles."
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   Margin="0,0,0,10"/>

                        <CheckBox x:Name="NetworkCheck"
                                  Content="Mostrar consumo de red"
                                  Foreground="#1F2937"
                                  FontSize="13"
                                  FontWeight="Normal"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="DiskCheck"
                                  Content="Mostrar uso del disco"
                                  Foreground="#1F2937"
                                  FontSize="13"
                                  FontWeight="Normal"/>

                    </StackPanel>

                </GroupBox>


                <!-- ATAJO -->
                <GroupBox Header="Atajo para mostrar / ocultar"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="#1F2937"
                          Padding="12,10,12,12">

                    <StackPanel>

                        <TextBlock Text="Presiona la combinación de teclas que deseas utilizar:"
                                   Foreground="#4B5563"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="HotkeyBox"
                                 Height="44"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="#111827"
                                 Background="#FFFFFF"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1"
                                 IsReadOnly="True"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Cursor="Hand"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                        <TextBlock Text="Ejemplo: Ctrl + Shift + M"
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                </GroupBox>

            </StackPanel>

        </ScrollViewer>


        <!-- ===================================== -->
        <!-- PIE FIJO CON BOTONES -->
        <!-- ===================================== -->

        <Border Grid.Row="2"
                Background="#F3F4F6"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="22,12,22,14">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancelar"
                        Width="90"
                        Height="32"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="Guardar"
                        Width="90"
                        Height="32"
                        IsDefault="True"
                        Click="Save_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>