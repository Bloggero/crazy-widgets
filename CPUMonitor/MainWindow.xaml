<Window x:Class="CPUMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU Monitor"
        Icon="Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Border x:Name="RootBorder"
            Margin="7"
            CornerRadius="18"
            Background="#E6111111"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            ClipToBounds="True"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">

        <Grid>

            <!-- ========================================= -->
            <!-- FONDO DE TEMA (SPEEDRUNNERS) -->
            <!-- ========================================= -->
            <Border x:Name="ThemeBackgroundContainer"
                    CornerRadius="17"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/speedrunners.png"
                                Stretch="UniformToFill"
                                AlignmentX="Center"
                                AlignmentY="Center"/>
                </Border.Background>

                <!-- Capa oscura de contraste -->
                <Border Background="#8C050810"
                        CornerRadius="17"/>
            </Border>

            <Grid Margin="12,10,12,12">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="IndicatorsRow"
                                    Height="Auto"/>
                </Grid.RowDefinitions>


            <!-- ========================================= -->
            <!-- HEADER -->
            <!-- ========================================= -->

            <Grid Grid.Row="0" Margin="2,0,2,6">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="SYSTEM"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="Black"/>

                    <TextBlock Text=" // "
                               Foreground="#666666"
                               FontSize="12"
                               FontWeight="Bold"/>

                    <TextBlock Text="MONITOR"
                               Foreground="#999999"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="SettingsButton"
                            Content="⚙"
                            Width="26"
                            Height="24"
                            Margin="0,0,2,0"
                            Click="SettingsButton_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                    <Button Content="×"
                            Width="26"
                            Height="24"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                </StackPanel>

            </Grid>


            <!-- ========================================= -->
            <!-- LINEA -->
            <!-- ========================================= -->

            <Rectangle Grid.Row="1"
                       Height="1"
                       Fill="#333333"
                       Margin="0,0,0,8"/>


            <!-- ========================================= -->
            <!-- INDICADORES -->
            <!-- ========================================= -->

            <Grid x:Name="IndicatorsGrid"
                  Grid.Row="2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Grid.RowDefinitions>

                    <RowDefinition x:Name="IndicatorRow1"
                                   Height="Auto"/>

                    <RowDefinition x:Name="IndicatorRow2"
                                   Height="Auto"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition x:Name="IndicatorColumn1"
                                      Width="Auto"/>

                    <ColumnDefinition x:Name="IndicatorColumn2"
                                      Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- ========================================= -->
                <!-- CPU -->
                <!-- ========================================= -->

                <Grid x:Name="CpuPanel"
                      Grid.Row="0"
                      Grid.Column="0"
                      Width="95"
                      Height="95"
                      Margin="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Ellipse Width="91"
                             Height="91"
                             Fill="#151515"
                             Stroke="#4A4A4A"
                             StrokeThickness="2"/>

                    <Ellipse Width="82"
                             Height="82"
                             Fill="Transparent"
                             Stroke="#292929"
                             StrokeThickness="1"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="CPU"
                                   Foreground="#888888"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CpuText"
                                   Text="0%"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CpuTemperatureText"
                                   Text="--°C"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>


                <!-- ========================================= -->
                <!-- RAM -->
                <!-- ========================================= -->

                <Grid x:Name="RamPanel"
                      Grid.Row="0"
                      Grid.Column="1"
                      Width="95"
                      Height="95"
                      Margin="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Ellipse Width="91"
                             Height="91"
                             Fill="#151515"
                             Stroke="#4A4A4A"
                             StrokeThickness="2"/>

                    <Ellipse Width="82"
                             Height="82"
                             Fill="Transparent"
                             Stroke="#292929"
                             StrokeThickness="1"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="RAM"
                                   Foreground="#888888"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="RamText"
                                   Text="0%"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="RamDetailsText"
                                   Text="0.0 / 0.0 GB"
                                   Foreground="#AAAAAA"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>


                <!-- ========================================= -->
                <!-- NETWORK -->
                <!-- ========================================= -->

                <Grid x:Name="NetworkPanel"
                      Grid.Row="1"
                      Grid.Column="0"
                      Width="95"
                      Height="95"
                      Margin="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Ellipse Width="91"
                             Height="91"
                             Fill="#151515"
                             Stroke="#4A4A4A"
                             StrokeThickness="2"/>

                    <Ellipse Width="82"
                             Height="82"
                             Fill="Transparent"
                             Stroke="#292929"
                             StrokeThickness="1"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="NETWORK"
                                   Foreground="#888888"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="DownloadText"
                                   Text="↓ 0 Kbps"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="UploadText"
                                   Text="↑ 0 Kbps"
                                   Foreground="#AAAAAA"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>


                <!-- ========================================= -->
                <!-- DISK -->
                <!-- ========================================= -->

                <Grid x:Name="DiskPanel"
                      Grid.Row="1"
                      Grid.Column="1"
                      Width="95"
                      Height="95"
                      Margin="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Ellipse Width="91"
                             Height="91"
                             Fill="#151515"
                             Stroke="#4A4A4A"
                             StrokeThickness="2"/>

                    <Ellipse Width="82"
                             Height="82"
                             Fill="Transparent"
                             Stroke="#292929"
                             StrokeThickness="1"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="DISK"
                                   Foreground="#888888"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="DiskText"
                                   Text="0%"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="ACTIVE"
                                   Foreground="#555555"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Border>

</Window>