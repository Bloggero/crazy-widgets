<Window x:Class="CPUMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU Monitor"
        Icon="Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Margin="7"
            CornerRadius="18"
            Background="#E6111111"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            ClipToBounds="True"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">

        <Grid>

            <!-- ========================================= -->
            <!-- FONDO DE TEMA (SPEEDRUNNERS) -->
            <!-- ========================================= -->
            <Border x:Name="ThemeBackgroundContainer"
                    CornerRadius="17"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/speedrunners.png"
                                Stretch="UniformToFill"
                                AlignmentX="Center"
                                AlignmentY="Center"/>
                </Border.Background>

                <!-- Capa oscura de contraste -->
                <Border Background="#8C050810"
                        CornerRadius="17"/>
            </Border>

            <!-- Capa de brillo Aero Glass (Windows 7) -->
            <Border x:Name="AeroGlassOverlay"
                    CornerRadius="12"
                    ClipToBounds="True"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.45*"/>
                        <RowDefinition Height="0.55*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="11,11,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3DFFFFFF" Offset="0.0"/>
                                <GradientStop Color="#08FFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="MainContentGrid" Margin="12,10,12,12">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="MonthlyNetworkRow"
                                   Height="Auto"/>
                    <RowDefinition x:Name="IndicatorsRow"
                                   Height="Auto"/>
                </Grid.RowDefinitions>


            <!-- ========================================= -->
            <!-- HEADER -->
            <!-- ========================================= -->

            <Border x:Name="HeaderBorder"
                    Grid.Row="0"
                    CornerRadius="0"
                    Padding="2,0,2,6"
                    Margin="0,0,0,0">
                <Grid>
                    <StackPanel x:Name="HeaderTitlePanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="HeaderTitle1"
                                   Text="SYSTEM"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Black"/>

                        <TextBlock x:Name="HeaderTitleSep"
                                   Text=" // "
                                   Foreground="#666666"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="HeaderTitle2"
                                   Text="MONITOR"
                                   Foreground="#999999"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                    </StackPanel>


                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="SettingsButton"
                                Style="{StaticResource WindowButtonStyle}"
                                Content="⚙"
                                Width="26"
                                Height="24"
                                Margin="0,0,2,0"
                                Click="SettingsButton_Click"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="Bold"
                                Cursor="Hand"/>

                        <Button x:Name="CloseButton"
                                Style="{StaticResource WindowButtonStyle}"
                                Content="×"
                                Width="26"
                                Height="24"
                                Click="CloseButton_Click"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold"
                                Cursor="Hand"/>

                    </StackPanel>

                </Grid>
            </Border>


            <!-- ========================================= -->
            <!-- LINEA SEPARADORA -->
            <!-- ========================================= -->

            <Rectangle x:Name="HeaderSeparator"
                       Grid.Row="1"
                       Height="1"
                       Fill="#333333"
                       Margin="0,0,0,8"/>


            <!-- ========================================= -->
            <!-- CONSUMO DE RED (30 DÍAS) -->
            <!-- ========================================= -->

            <Border x:Name="MonthlyNetworkContainer"
                    Grid.Row="2"
                    Background="#141414"
                    BorderBrush="#2E2E2E"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,6,10,6"
                    Margin="2,0,2,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="MonthlyNetworkHeaderLabel"
                                   Text="Red (30 días):"
                                   Foreground="#9E9E9E"
                                   FontSize="9.5"
                                   FontWeight="Bold"/>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="MonthlyNetworkTotalLabel"
                                       Text="Total: "
                                       Foreground="#888888"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="MonthlyNetworkTotalText"
                                       Text="0.0 GB"
                                       Foreground="#38BDF8"
                                       FontSize="12"
                                       FontWeight="Black"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="MonthlyDownloadText"
                                   Text="↓ Descarga: 0.0 GB"
                                   Foreground="#F1F5F9"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>

                        <TextBlock x:Name="MonthlyUploadText"
                                   Text="↑ Subida: 0.0 GB"
                                   Foreground="#94A3B8"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- ========================================= -->
            <!-- INDICADORES -->
            <!-- ========================================= -->

            <Grid x:Name="IndicatorsGrid"
                  Grid.Row="3"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Grid.RowDefinitions>

                    <RowDefinition x:Name="IndicatorRow1"
                                   Height="Auto"/>

                    <RowDefinition x:Name="IndicatorRow2"
                                   Height="Auto"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition x:Name="IndicatorColumn1"
                                      Width="Auto"/>

                    <ColumnDefinition x:Name="IndicatorColumn2"
                                      Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- ========================================= -->
                <!-- CPU -->
                <!-- ========================================= -->

                <Grid x:Name="CpuPanel"
                      Grid.Row="0"
                      Grid.Column="0"
                      Width="95"
                      Height="95"
                      Margin="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Ellipse x:Name="CpuOuterShape"
                             Width="91"
                             Height="91"
                             Fill="#151515"
                             Stroke="#4A4A4A"
                             StrokeThickness="2"/>

                    <Ellipse x:Name="CpuInnerShape"
                             Width="82"
                             Height="82"
                             Fill="Transparent"
                             Stroke="#292929"
                             StrokeThickness="1"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="CpuLabel"
                                   Text="CPU"
                                   Foreground="#888888"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CpuText"
                                   Text="0%"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CpuTemperatureText"
                                   Text="--°C"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>


                <!-- ========================================= -->
                <!-- RAM -->
                <!-- ========================================= -->

                <Grid x:Name="RamPanel"
                      Grid.Row="0"
                      Grid.Column="1"
                      Width="95"
                      Height="95"
                      Margin="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Ellipse x:Name="RamOuterShape"
                             Width="91"
                             Height="91"
                             Fill="#151515"
                             Stroke="#4A4A4A"
                             StrokeThickness="2"/>

                    <Ellipse x:Name="RamInnerShape"
                             Width="82"
                             Height="82"
                             Fill="Transparent"
                             Stroke="#292929"
                             StrokeThickness="1"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="RamLabel"
                                   Text="RAM"
                                   Foreground="#888888"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="RamText"
                                   Text="0%"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="RamDetailsText"
                                   Text="0.0 / 0.0 GB"
                                   Foreground="#AAAAAA"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>


                <!-- ========================================= -->
                <!-- NETWORK -->
                <!-- ========================================= -->

                <Grid x:Name="NetworkPanel"
                      Grid.Row="1"
                      Grid.Column="0"
                      Width="95"
                      Height="95"
                      Margin="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Ellipse x:Name="NetworkOuterShape"
                             Width="91"
                             Height="91"
                             Fill="#151515"
                             Stroke="#4A4A4A"
                             StrokeThickness="2"/>

                    <Ellipse x:Name="NetworkInnerShape"
                             Width="82"
                             Height="82"
                             Fill="Transparent"
                             Stroke="#292929"
                             StrokeThickness="1"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="NetworkLabel"
                                   Text="NETWORK"
                                   Foreground="#888888"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="DownloadText"
                                   Text="↓ 0 Kbps"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="UploadText"
                                   Text="↑ 0 Kbps"
                                   Foreground="#AAAAAA"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>


                <!-- ========================================= -->
                <!-- DISK -->
                <!-- ========================================= -->

                <Grid x:Name="DiskPanel"
                      Grid.Row="1"
                      Grid.Column="1"
                      Width="95"
                      Height="95"
                      Margin="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Ellipse x:Name="DiskOuterShape"
                             Width="91"
                             Height="91"
                             Fill="#151515"
                             Stroke="#4A4A4A"
                             StrokeThickness="2"/>

                    <Ellipse x:Name="DiskInnerShape"
                             Width="82"
                             Height="82"
                             Fill="Transparent"
                             Stroke="#292929"
                             StrokeThickness="1"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="DiskLabel"
                                   Text="DISK"
                                   Foreground="#888888"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="DiskText"
                                   Text="0%"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="DiskSubLabel"
                                   Text="ACTIVE"
                                   Foreground="#555555"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Border>

</Window>